# ─────────────────────────────────────────────────────────────────────────────
# URQR Platform — Environment variable reference
# Copy this file to .env and fill in all values before running Docker Compose.
# .env is git-ignored; this file is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL 18.7 ──────────────────────────────────────────────────────────
POSTGRES_DB=urqr
DB_USER=urqr
DB_PASSWORD=                    # required — set your local password
POSTGRES_PORT=5433              # host port for direct DBA/admin access

# ── Redis 8.2.11 ─────────────────────────────────────────────────────────────
REDIS_PORT=6379                 # host port

# ── Spring Boot application ───────────────────────────────────────────────────
API_PORT=8081                   # host port for the Spring Boot server

# ── JWT (Spring Security) ─────────────────────────────────────────────────────
JWT_SECRET=                     # min 32 chars
JWT_TTL_MINUTES=60

# ── Platform bootstrap secrets ────────────────────────────────────────────────
PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_PASSWORD=        # required

# ── Centrifugo 6.10.3 ────────────────────────────────────────────────────────
# Optional in local dev (compose falls back to safe dev defaults).
# Must be set explicitly in staging and production.
CENTRIFUGO_TOKEN_SECRET=        # min 32 chars — HMAC secret for JWT tokens
CENTRIFUGO_API_KEY=             # backend uses this to publish via HTTP API
CENTRIFUGO_ADMIN_PASSWORD=      # Centrifugo web UI admin password
CENTRIFUGO_ADMIN_SECRET=        # Centrifugo admin API secret

# ── Exa web search ───────────────────────────────────────────────────────────
# Server-side web search via the official exa-js SDK (scripts/exa-web-search.js).
# Never expose this key to the browser bundle.
EXA_API_KEY=                    # required — https://dashboard.exa.ai/api-keys

# ─────────────────────────────────────────────────────────────────────────────
# Connection reference (copy into Spring Boot application.properties / yml)
# ─────────────────────────────────────────────────────────────────────────────
# spring.datasource.url=jdbc:postgresql://localhost:5432/${POSTGRES_DB}?prepareThreshold=0
# spring.datasource.username=${DB_USER}
# spring.datasource.password=${DB_PASSWORD}
# spring.data.redis.url=redis://localhost:${REDIS_PORT}
# centrifugo.url=http://localhost:8000
# centrifugo.api-key=${CENTRIFUGO_API_KEY}
