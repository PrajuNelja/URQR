		{
			"name": "02 - Manager Login (Happy Path & JWT RS256 Audit)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Login response latency is acceptable (<3000ms)', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(3000);",
							"});",
							"",
							"const jsonData = pm.response.json();",
							"",
							"// Task 2: Validate JWT Structure - RS256 Header & Claims",
							"pm.test('JWT Access Token has valid 3-part signature structure', function () {",
							"    pm.expect(jsonData).to.have.property('accessToken');",
							"    pm.expect(jsonData.accessToken).to.be.a('string');",
							"    const parts = jsonData.accessToken.split('.');",
							"    pm.expect(parts.length).to.eql(3);",
							"",
							"    const decodeB64 = function(s) {",
							"        try {",
							"            if (typeof Buffer !== 'undefined') return Buffer.from(s, 'base64').toString('utf8');",
							"            return atob(s.replace(/-/g, '+').replace(/_/g, '/'));",
							"        } catch (_) {",
							"            return atob(s);",
							"        }",
							"    };",
							"",
							"    // Decode Header",
							"    const header = JSON.parse(decodeB64(parts[0]));",
							"    pm.expect(header.alg).to.eql('RS256');",
							"    pm.expect(header.typ).to.eql('JWT');",
							"",
							"    // Decode Payload Claims",
							"    const claims = JSON.parse(decodeB64(parts[1]));",
							"    pm.expect(claims).to.have.property('sub');",
							"    pm.expect(claims).to.have.property('uid');",
							"    pm.expect(claims).to.have.property('hotel_id');",
							"    pm.expect(claims).to.have.property('role');",
							"    pm.expect(claims.role).to.eql('MANAGER');",
							"    pm.expect(claims).to.have.property('exp');",
							"    pm.expect(claims).to.have.property('jti');",
							"",
							"    // Save tokens to environment",
							"    pm.environment.set('authToken', jsonData.accessToken);",
							"    if (jsonData.refreshToken) {",
							"        pm.environment.set('refreshToken', jsonData.refreshToken);",
							"    }",
							"});",
							"",
							"pm.test('User profile returned with matching username and role', function () {",
							"    pm.expect(jsonData.username).to.eql(pm.environment.get('posUsername') || 'pos_manager_1');",
							"    pm.expect(jsonData.role).to.eql('MANAGER');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{posUsername}}\",\n    \"password\": \"{{posPassword}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
