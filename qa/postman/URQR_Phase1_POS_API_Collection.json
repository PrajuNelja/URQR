		{
			"name": "01 - Health & Liveness Probe",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response latency is acceptable (<300ms)', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(300);",
							"});",
							"",
							"pm.test('Service reports UP status', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('UP');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/actuator/health/liveness",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"actuator",
						"health",
						"liveness"
					]
				}
			},
			"response": []
		},
		{
			"name": "02 - Manager Login (Zero-Tenant Happy Path)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Login response latency is < 300ms', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(300);",
							"});",
							"",
							"// Schema Contract: AuthResponseSchema { token: string, user: { username, role } }",
							"pm.test('Response matches AuthResponseSchema contract', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('token');",
							"    pm.expect(jsonData.token).to.be.a('string');",
							"    pm.expect(jsonData.token.length).to.be.above(20);",
							"    pm.environment.set('authToken', jsonData.token);",
							"",
							"    pm.expect(jsonData).to.have.property('user');",
							"    pm.expect(jsonData.user).to.have.property('username');",
							"    pm.expect(jsonData.user).to.have.property('role');",
							"    pm.expect(jsonData.user.username).to.eql(pm.environment.get('posUsername') || 'pos_manager_1');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{posUsername}}\",\n    \"password\": \"{{posPassword}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
