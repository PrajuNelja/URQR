		{
			"name": "08 - Brute-Force Rate Limiting (10 Rapid Failed Logins)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Rate limiting kicks in with 429 Too Many Requests after rapid attacks', function () {",
							"    pm.response.to.have.status(429);",
							"});",
							"pm.test('Response contains Retry-After header for rate throttling', function () {",
							"    pm.expect(pm.response.headers.has('Retry-After')).to.be.true;",
							"});",
							"pm.test('Response payload informs user of temporary lockout', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('error');",
							"    pm.expect(jsonData.error.toLowerCase()).to.include('too many');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
