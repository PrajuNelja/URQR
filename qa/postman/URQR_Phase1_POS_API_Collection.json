			"name": "17 - Out-of-Stock and Multi-Tax Inventory Verification",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK for full catalog audit', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const jsonData = pm.response.json();",
							"const products = Array.isArray(jsonData) ? jsonData : jsonData.items;",
							"",
							"pm.test('Out-of-stock items have inStock false and zero quantity', function () {",
							"    const oosItems = products.filter(p => p.itemType === 'OUT_OF_STOCK' || p.inStock === false);",
							"    pm.expect(oosItems.length).to.be.above(0);",
							"    oosItems.forEach(item => {",
							"        pm.expect(item.inStock).to.be.false;",
							"        pm.expect(item.stockQuantity).to.eql(0);",
							"    });",
							"});",
							"",
							"pm.test('Multi-tax items carry tax rate and component breakdowns', function () {",
							"    const multiTaxItems = products.filter(p => p.itemType === 'MULTI_TAX');",
							"    pm.expect(multiTaxItems.length).to.be.above(0);",
							"    multiTaxItems.forEach(item => {",
							"        pm.expect(item).to.have.property('taxRate');",
							"        pm.expect(item).to.have.property('taxComponents');",
							"        pm.expect(Array.isArray(item.taxComponents)).to.be.true;",
							"    });",
							"});"
