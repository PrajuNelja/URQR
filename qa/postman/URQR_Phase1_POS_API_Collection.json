							"",
							"// Schema Contract: CategorySchema { id, name, slug }",
							"pm.test('Categories conform to CategorySchema contract', function () {",
							"    const jsonData = pm.response.json();",
							"    const categories = Array.isArray(jsonData) ? jsonData : jsonData.categories;",
							"    pm.expect(Array.isArray(categories)).to.be.true;",
							"    pm.expect(categories.length).to.be.above(0);",
							"",
							"    const cat = categories[0];",
							"    pm.expect(cat).to.have.property('id');",
							"    pm.expect(cat).to.have.property('name');",
							"    pm.expect(cat).to.have.property('slug');",
							"    pm.expect(typeof cat.name).to.eql('string');",
							"});"
						],
