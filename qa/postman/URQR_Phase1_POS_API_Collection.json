			"name": "09 - Catalog Products (Contract Schema Validation)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Products conform to ProductItemSchema contract', function () {",
							"    const jsonData = pm.response.json();",
							"    const products = Array.isArray(jsonData) ? jsonData : (jsonData.products || jsonData.items);",
							"    pm.expect(Array.isArray(products)).to.be.true;",
							"    pm.expect(products.length).to.be.above(0);",
							"",
							"    const item = products[0];",
							"    pm.expect(item).to.have.property('id');",
							"    pm.expect(item).to.have.property('name');",
							"    pm.expect(item).to.have.property('price');",
							"    pm.expect(typeof item.name).to.eql('string');",
							"    pm.expect(typeof item.price).to.eql('number');",
							"});"
						],
						"type": "text/javascript"
					}
				}
