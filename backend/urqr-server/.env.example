# Copy this file to .env and replace each placeholder before starting Docker Compose.
POSTGRES_DB=urqr
DB_USER=urqr
DB_PASSWORD=replace-with-a-private-database-password
DB_MIGRATION_USER=urqr
DB_MIGRATION_PASSWORD=replace-with-a-private-database-password
APP_DB_USER=urqr_app
APP_DB_PASSWORD=replace-with-a-separate-private-app-password
POSTGRES_PORT=5433
REDIS_PORT=6379
API_PORT=8080
# Generate a 2048-bit RSA key pair; store the PKCS#8 private key and X.509 public key as Base64 DER.
JWT_PRIVATE_KEY=replace-with-base64-pkcs8-rsa-private-key
JWT_PUBLIC_KEY=replace-with-base64-x509-rsa-public-key
JWT_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173\
CENTRIFUGO_TOKEN_SECRET=hhfbhdsuhiahhgwsaufjshafyehsufhhsu
CENTRIFUGO_API_KEY=replace-with-a-private-centrifugo-api-key
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_ADMIN_SECRET=replace-with-a-private-centrifugo-admin-secret
OUTBOX_ENABLED=true
OUTBOX_POLL_DELAY_MS=50
