{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URQR Manager POS",
  "version": "1.0.0",
  "identifier": "com.urqr.manager-pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../manager-pos/dist"
  },
  "app": {
    "windows": [
      {
        "title": "URQR Manager POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
