{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URQR Manager POS",
  "version": "1.0.0",
  "identifier": "com.urqr.manager-pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../manager-pos/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "URQR Manager POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1366,
        "minHeight": 768,
        "maxWidth": 1366,
        "maxHeight": 768,
        "center": true,
        "resizable": false,
        "decorations": false,
        "fullscreen": false
      }
    ]
  }
}
