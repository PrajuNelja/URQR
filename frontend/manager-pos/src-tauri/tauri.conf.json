{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URQR Manager POS",
  "version": "1.0.0",
  "identifier": "com.nelja.urqr.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter manager-pos dev",
    "beforeBuildCommand": "pnpm --filter manager-pos build"
  },
  "app": {
    "windows": [
      {
        "title": "URQR - Manager POS Terminal",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
