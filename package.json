{
  "name": "urqr",
  "version": "1.0.0",
  "description": "URQR is the Hotel & Restaurant Operations Platform developed by NELJA TECH. The repository is organized as a modular monolith with shared frontend packages and dedicated documentation, quality assurance, and infrastructure areas.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:viewports": "playwright test tests/pos-viewport.spec.ts",
    "test:primitives": "playwright test tests/ui-primitives.spec.ts",
    "test:smoke": "playwright test tests/frontend-smoke.spec.ts",
    "test:health": "node scripts/verify-backend-liveness.js",
    "test:health:e2e": "playwright test tests/backend-health.spec.ts",
    "test:printer": "python qa/printer-simulator/Test_printer.py",
    "test:k6": "node scripts/run-k6-benchmark.js",
    "test:k6:native": "k6 run qa/k6-tests/baseline.js",
    "test:report": "playwright show-report",
    "exa:search": "node scripts/exa-web-search.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrajuNelja/URQR.git"
  },
  "keywords": [],
