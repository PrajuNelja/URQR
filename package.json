  "bugs": {
    "url": "https://github.com/PrajuNelja/URQR/issues"
  },
  "homepage": "https://github.com/PrajuNelja/URQR#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "exa-js": "2.29.0"
  }
}
